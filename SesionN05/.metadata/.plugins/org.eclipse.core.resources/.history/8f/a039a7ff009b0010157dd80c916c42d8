package actividad1;

public class Main {
    public static void main(String[] args) {
        String[] nombres = {"Juan", "Luz", "Luna", "Pepe"};
        Integer[] numeros = {1, 2, 3, 4};

        System.out.println("Arreglo completo:");
        Funciones.imprimirArreglo(nombres);
        Funciones.imprimirArreglo(numeros);

        try {
            System.out.println("Subarreglo:");
            int cantidad = Funciones.imprimirArreglo(nombres, 1, 3);
            System.out.println("Cantidad de elementos impresos: " + cantidad);
        } catch (InvalidSubscriptException e) {
            System.out.println("Error: " + e.getMessage());
        }

        try {
            Funciones.imprimirArreglo(numeros, 4, 2); // Esto lanza excepción
        } catch (InvalidSubscriptException e) {
            System.out.println("Error: " + e.getMessage());
        }
    }
}
