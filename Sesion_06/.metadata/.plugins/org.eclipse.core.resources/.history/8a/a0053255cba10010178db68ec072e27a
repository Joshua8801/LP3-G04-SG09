package ejercicio2;

import java.util.List;
import java.util.Scanner;

public class InventarioView {
    private Scanner scanner;

    public InventarioView() {
        scanner = new Scanner(System.in);
    }

    public void mostrarMenu() {
        System.out.println("\nMenú de Inventario:");
        System.out.println("1. Agregar Item");
        System.out.println("2. Eliminar Item");
        System.out.println("3. Ver Inventario");
        System.out.println("4. Mostrar Detalles de Item");
        System.out.println("5. Buscar Item");
        System.out.println("6. Salir");
        System.out.print("Selecciona una opción: ");
    }

    public String solicitarOpcion() {
        return scanner.nextLine();
    }

    public String solicitarNombreItem() {
        System.out.print("Nombre del item: ");
        return scanner.nextLine();
    }

    public int solicitarCantidadItem() {
        System.out.print("Cantidad: ");
        return Integer.parseInt(scanner.nextLine());
    }

    public String solicitarTipoItem() {
        System.out.print("Tipo: ");
        return scanner.nextLine();
    }

    public String solicitarDescripcionItem() {
        System.out.print("Descripción: ");
        return scanner.nextLine();
    }

    public void mostrarInventario(List<Item> items) {
        if (items.isEmpty()) {
            System.out.println("El inventario está vacío.");
        } else {
            System.out.println("Inventario:");
            for (Item item : items) {
                System.out.println("- " + item.getNombre() + " (" + item.getTipo() + ") x" + item.getCantidad());
            }
        }
    }

    public void mostrarMensaje(String mensaje) {
        System.out.println(mensaje);
    }

    public void mostrarDetallesItem(Item item) {
        if (item != null) {
            System.out.println("Detalles del Item:");
            System.out.println("Nombre: " + item.getNombre());
            System.out.println("Tipo: " + item.getTipo());
            System.out.println("Cantidad: " + item.getCantidad());
            System.out.println("Descripción: " + item.getDescripcion());
        } else {
            System.out.println("Item no encontrado.");
        }
    }
}